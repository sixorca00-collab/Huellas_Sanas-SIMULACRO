<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.huellasanas.ui.controllers.VeterinarioController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <VBox prefWidth="150.0" prefHeight="400.0" spacing="20" style="-fx-background-color: #f4f4f4; -fx-padding: 20;">
            <children>
                <Label text="Menú" style="-fx-font-weight: bold;"/>
                <Button text="Ver Citas" onAction="#verCitas" maxWidth="Infinity" />
                <Button text="Ver Clientes" onAction="#verClientes" maxWidth="Infinity" />
                <Separator />
                <Button text="Cerrar Sesión" onAction="#cerrarSesion" maxWidth="Infinity" />
            </children>
        </VBox>

        <AnchorPane fx:id="contentPane" layoutX="150.0" prefWidth="450.0" prefHeight="400.0" />
    </children>
</AnchorPane>